# ── Mail (Resend) ─────────────────────────────────────────────────────────────
# Required. src/lib/mailer.ts throws at runtime if this is missing.
RESEND_API_KEY=re_change_me

# Optional. Sender address; defaults to "AC Coursing <onboarding@resend.dev>".
# Named SMTP_FROM for historical reasons — mail is sent via the Resend API.
SMTP_FROM="AC Coursing <mailer@example.com>"

# Optional. Where contact/devis submissions land; defaults to client.email.
CONTACT_RECIPIENT_EMAIL=contact@accoursing.fr

# ── Google Places (homepage rating + review count) ───────────────────────────
# Optional. If unset or the request fails, hardcoded fallback figures are shown.
GOOGLE_PLACES_API_KEY=change-me
GOOGLE_PLACE_ID=ChIJchange-me
# Shown whenever the live lookup is unavailable (e.g. Google billing not enabled).
# Update these by hand to match your Google Business Profile; restart to apply.
REVIEW_COUNT_FALLBACK=243
REVIEW_RATING_FALLBACK=5.0

# ── Server (node standalone adapter) ─────────────────────────────────────────
# Not needed for local dev — the adapter already listens on 127.0.0.1:4321.
# In a container, set HOST=0.0.0.0 in the host's env UI (e.g. Coolify), or the
# proxy cannot reach the app and every request 502s. PORT defaults to 4321.
# HOST=0.0.0.0
# PORT=4321

# AC Coursing CRM: file every quote request there too (leave empty to disable)
CRM_INTAKE_URL=
CRM_INTAKE_SECRET=
