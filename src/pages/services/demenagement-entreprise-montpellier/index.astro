---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CTA from '../../../components/CTA.astro';
import FAQSection from '../../../components/FAQSection.astro';
import BofuHero from '../../../components/BofuHero.astro';
import TablerIcon from '../../../components/TablerIcon.astro';
import { client } from '../../../data/client';
import { getPlacesData, formatRating } from '../../../lib/google-places';

const places = await getPlacesData();
const ratingDisplay = formatRating(places.rating);

const faqItems = [
  {
    question: 'Pouvez-vous intervenir en dehors des horaires de bureau ?',
    answer: "Oui. La plupart des déménagements d'entreprise sont planifiés le soir ou le week-end pour ne pas interrompre votre activité. Le créneau est fixé avec vous au moment du devis.",
    open: true,
  },
  {
    question: 'Comment gérez-vous le matériel informatique et les dossiers sensibles ?',
    answer: "Le matériel informatique est emballé et transporté séparément, et les dossiers/archives sont manipulés avec la même rigueur que le mobilier. Le détail de l'organisation est convenu avec vous avant le jour J.",
  },
  {
    question: 'Le déménagement peut-il se faire sur plusieurs sites ?',
    answer: "Oui, nous organisons aussi bien un déménagement mono-site qu'un transfert entre plusieurs locaux ou vers de nouveaux bureaux, avec une seule équipe et un interlocuteur unique.",
  },
  {
    question: 'Le prix dépend-il du nombre de postes de travail ?',
    answer: "Le volume à transporter (postes de travail, mobilier, archives, équipements) est le principal facteur de prix, avec l'accès aux locaux et le créneau souhaité. Le devis détaille chaque poste.",
  },
];
---

<BaseLayout
  title="Déménagement Entreprise Montpellier | Devis | AC Coursing"
  description="Déménagement d'entreprise à Montpellier : bureaux, matériel informatique, archives. Créneaux hors horaires de bureau, prix fixe garanti. Devis sous 24h."
  schema={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Déménagement d'entreprise",
        provider: { '@type': 'MovingCompany', name: client.name, telephone: client.phoneForTel, url: client.domain },
        areaServed: { '@type': 'City', name: 'Montpellier' },
        description: "Déménagement de bureaux et d'entreprises à Montpellier, organisé pour limiter l'interruption d'activité.",
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${client.domain}/` },
          { '@type': 'ListItem', position: 2, name: 'Services', item: `${client.domain}/services` },
          { '@type': 'ListItem', position: 3, name: "Déménagement d'entreprise", item: `${client.domain}/services/demenagement-entreprise-montpellier/` },
        ],
      },
    ],
  }}
>
  <Header slot="header" />

  <BofuHero
    crumbs={[
      { label: 'Services', href: '/services' },
      { label: 'Entreprise' },
    ]}
    heading="Déménagement d'entreprise à Montpellier"
    description="Bureaux, matériel informatique, archives : un déménagement professionnel organisé pour limiter l'interruption d'activité."
    points={[
      { icon: 'calendar', text: 'Créneaux en soirée ou le week-end pour ne pas interrompre votre activité' },
      { icon: 'shield-check', text: 'Assurance transport incluse pour le mobilier et le matériel professionnel' },
      { icon: 'truck-delivery', text: 'Transfert mono-site ou multi-sites avec un interlocuteur unique' },
      { icon: 'box', text: 'Emballage et protection du matériel informatique et des archives' },
    ]}
  />

  <section class="bg-background py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16 items-center">

        <div>
          <img
            src="/images/professionnel/professionnel-01.webp"
            alt="Équipe AC Coursing lors d'un déménagement d'entreprise à Montpellier"
            loading="lazy"
            decoding="async"
            class="w-full rounded-2xl border border-border object-cover aspect-[4/3]"
          />
        </div>

        <div class="space-y-6">
          <h2 class="font-heading text-h2 text-foreground">Un déménagement de bureaux, ça se planifie</h2>
          <p class="text-lg leading-relaxed text-muted-foreground">
            Un déménagement de bureaux ne s'organise pas comme un déménagement résidentiel : contrainte d'horaires, matériel sensible, continuité de service. On planifie chaque étape avec vous pour que l'activité reprenne sans retard.
          </p>
          <p class="leading-relaxed text-muted-foreground">
            Démontage et remontage du mobilier de bureau inclus, quel que soit le nombre de sites concernés.
          </p>

          <a
            href="/devis"
            class="inline-flex min-h-12 items-center gap-2 rounded-full bg-primary px-8 py-3 text-base font-bold text-primary-foreground shadow-md transition-all hover:opacity-90"
          >
            Devis gratuit
            <TablerIcon name="arrow-right" class="text-base leading-none" />
          </a>
        </div>
      </div>

      <div class="mt-16 rounded-2xl border border-border bg-panel p-8 sm:p-10">
        <h2 class="font-heading text-h3 text-foreground">Ce qui influence le prix d'un déménagement d'entreprise</h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
          Chaque structure a ses propres contraintes. Le devis détaille précisément ce qui compose le prix final — aucun montant n'est avancé avant d'avoir vu votre situation.
        </p>
        <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {[
            'Nombre de postes de travail et volume de mobilier',
            'Accès aux locaux (étage, ascenseur, stationnement)',
            'Créneau souhaité (jour ouvré, soirée, week-end)',
            'Prestations additionnelles (démontage, mise en carton, archives)',
          ].map((text) => (
            <li class="flex items-start gap-2.5 text-sm text-muted-foreground">
              <TablerIcon name="check" class="mt-0.5 shrink-0 text-base leading-none text-primary" />
              {text}
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-6 border-t border-border pt-12 sm:grid-cols-3">
        {[
          { value: '1 500+', label: 'déménagements réalisés' },
          { value: `${ratingDisplay}/5`, label: 'note Google' },
          { value: '24h', label: 'réponse garantie' },
        ].map(({ value, label }) => (
          <div class="text-center" data-reveal>
            <p class="font-heading text-4xl font-medium text-primary">{value}</p>
            <p class="mt-1 text-sm text-muted-foreground">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FAQSection topper="FAQ Entreprise" heading="Questions sur le déménagement d'entreprise" items={faqItems} headingLevel="h3" />

  <CTA
    title="Votre devis déménagement d'entreprise"
    description="Postes de travail, matériel, créneau souhaité : remplissez le formulaire et recevez un prix fixe garanti sous 24h."
    headingLevel="h3"
  />
  <Footer slot="footer" />
</BaseLayout>
