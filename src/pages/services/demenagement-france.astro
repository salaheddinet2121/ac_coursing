---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';
import BofuHero from '../../components/BofuHero.astro';
import TablerIcon from '../../components/TablerIcon.astro';
import { client } from '../../data/client';
---

<BaseLayout
  title="Déménagement partout en France — AC Coursing Montpellier"
  description="Déménagement vers toutes les villes de France depuis Montpellier. Emballage, transport, installation : on gère tout. Prix fixe, assurance incluse."
  schema={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: 'Déménagement au sein de la France',
        provider: { '@type': 'MovingCompany', name: client.name, telephone: client.phoneForTel, url: client.domain },
        areaServed: { '@type': 'Country', name: 'France' },
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${client.domain}/` },
          { '@type': 'ListItem', position: 2, name: 'Services', item: `${client.domain}/services` },
          { '@type': 'ListItem', position: 3, name: 'Déménagement France', item: `${client.domain}/services/demenagement-france` },
        ],
      },
    ],
  }}
>
  <Header slot="header" />

  <BofuHero
    crumbs={[
      { label: 'Services', href: '/services' },
      { label: 'Déménagement France' },
    ]}
    heading="Déménagement partout en France depuis Montpellier"
    description="Paris, Lyon, Bordeaux ou un village du Sud — on gère le déménagement de bout en bout, un camion, une équipe, un interlocuteur."
    points={[
      { icon: 'building', text: 'Départ depuis Montpellier et tout le 34' },
      { icon: 'truck-delivery', text: 'Transport direct sans escale' },
      { icon: 'box', text: 'Emballage professionnel inclus sur demande' },
      { icon: 'shield-check', text: 'Assurance transport incluse sur chaque prestation' },
    ]}
  />

  <section class="bg-background py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16 items-center">
        <div>
          <img
            src="/images/residentiel/residentiel-01.webp"
            alt="Chargement du mobilier pour un déménagement partout en France — AC Coursing Montpellier"
            loading="lazy"
            decoding="async"
            class="w-full rounded-2xl border border-border object-cover aspect-[4/3]"
          />
        </div>
        <div class="space-y-6">
          <h2 class="font-heading text-h2 text-foreground">Un seul interlocuteur, du départ à la livraison</h2>
          <p class="text-lg leading-relaxed text-muted-foreground">
            Que vous partiez à Paris, Lyon, Bordeaux ou dans un village du Sud — on gère le déménagement de bout en bout. Emballage, chargement, transport, livraison et remise en place dans votre nouveau logement.
          </p>
          <p class="leading-relaxed text-muted-foreground">
            Pas de sous-traitants, pas de rupture de charge. Créneau confirmé à l'avance, livraison dans les délais.
          </p>
          <a href="/devis" class="inline-flex min-h-12 items-center gap-2 rounded-full bg-primary px-8 py-3 text-base font-bold text-primary-foreground shadow-md transition-all hover:opacity-90">
            Devis gratuit
            <TablerIcon name="arrow-right" class="text-base leading-none" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTA headingLevel="h3" />
  <Footer slot="footer" />
</BaseLayout>
