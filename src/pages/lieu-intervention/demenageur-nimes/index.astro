---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CTA from '../../../components/CTA.astro';
import FAQSection from '../../../components/FAQSection.astro';
import TablerIcon from '../../../components/TablerIcon.astro';
import { client } from '../../../data/client';
import { getPlacesData, formatRating } from '../../../lib/google-places';

const places = await getPlacesData();
const ratingDisplay = formatRating(places.rating);

const faqItems = [
  {
    question: 'Intervenez-vous vraiment à Nîmes ou seulement à Montpellier ?',
    answer: "Nîmes fait partie de notre zone d'intervention régulière : environ 50 km depuis Montpellier via l'A9, soit 40 à 45 minutes de route. Nos équipes s'y déplacent aussi souvent qu'à Montpellier même.",
    open: true,
  },
  {
    question: "L'accès au centre historique de Nîmes pose-t-il problème ?",
    answer: "Les rues étroites du centre ancien (autour des Arènes et de la Maison Carrée) demandent une organisation spécifique : stationnement du camion, créneau de portage. On anticipe ces contraintes avec vous avant le jour J.",
  },
  {
    question: 'Le prix est-il différent pour un déménagement à Nîmes ?',
    answer: "La distance Montpellier-Nîmes reste modérée et n'alourdit pas fortement le prix. Le volume à transporter et l'accès aux adresses restent les facteurs principaux, comme pour un déménagement local.",
  },
  {
    question: 'Pouvez-vous organiser un déménagement depuis Nîmes vers Montpellier ?',
    answer: 'Oui, le trajet fonctionne dans les deux sens. Le devis se construit de la même façon, quel que soit le sens du déménagement.',
  },
];
---

<BaseLayout
  title="Déménageur Nîmes | Devis Gratuit | AC Coursing"
  description="Déménageur à Nîmes : équipe locale, prix annoncé = prix payé, devis gratuit sous 24h. Emballage et transport assurés. Demandez votre estimation en ligne."
  schema={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: 'Déménageur Nîmes',
        provider: { '@type': 'MovingCompany', name: client.name, telephone: client.phoneForTel, url: client.domain },
        areaServed: { '@type': 'City', name: 'Nîmes' },
        description: "Déménagement à Nîmes depuis Montpellier, à environ 50 km via l'A9, prix fixe garanti.",
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${client.domain}/` },
          { '@type': 'ListItem', position: 2, name: 'Prestations', item: `${client.domain}/prestations/` },
          { '@type': 'ListItem', position: 3, name: 'Déménageur Nîmes', item: `${client.domain}/lieu-intervention/demenageur-nimes/` },
        ],
      },
    ],
  }}
>
  <Header slot="header" />

  <section class="bg-primary py-14 sm:py-16">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-primary-fg/60">
          <li><a href="/" class="hover:text-primary-fg transition-colors">Accueil</a></li>
          <li class="flex items-center gap-1.5"><TablerIcon name="chevron-right" class="size-3.5" /><a href="/prestations" class="hover:text-primary-fg transition-colors">Prestations</a></li>
          <li class="flex items-center gap-1.5"><TablerIcon name="chevron-right" class="size-3.5" /><span class="text-primary-fg" aria-current="page">Nîmes</span></li>
        </ol>
      </nav>
      <h1 class="font-heading text-h1 text-primary-fg">Déménageur à Nîmes</h1>
      <p class="mt-3 max-w-xl text-primary-fg/80">À environ 50 km de Montpellier, nos équipes interviennent régulièrement à Nîmes avec la même organisation et le même prix fixe garanti.</p>
    </div>
  </section>

  <section class="bg-background py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16 items-center">

        <div>
          <img
            src="/hero_image.webp"
            alt="Camion AC Coursing prêt pour un déménagement entre Montpellier et Nîmes"
            loading="lazy"
            decoding="async"
            class="w-full rounded-2xl border border-border object-cover aspect-[4/3]"
          />
        </div>

        <div class="space-y-6">
          <p class="text-lg leading-relaxed text-muted-foreground">
            Nîmes fait partie de notre zone d'intervention régulière, au même titre que Montpellier et son agglomération. Le trajet par l'A9 est court, mais l'organisation reste la même : cadrage du volume, créneau confirmé, accès aux deux adresses anticipé.
          </p>

          <ul class="space-y-4">
            {[
              { icon: 'map-pin', text: "Environ 50 km depuis Montpellier — 40 à 45 minutes via l'A9" },
              { icon: 'truck-delivery', text: 'Équipe locale, même organisation que pour un déménagement à Montpellier' },
              { icon: 'shield-check', text: 'Assurance transport incluse sur tout le trajet' },
              { icon: 'stairs', text: "Accès au centre historique anticipé (rues étroites, stationnement du camion)" },
              { icon: 'calendar', text: 'Créneau de chargement et de livraison confirmé à l\'avance' },
            ].map(({ icon, text }) => (
              <li class="flex items-start gap-3">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary mt-0.5">
                  <TablerIcon name={icon} class="text-lg leading-none" />
                </span>
                <span class="text-muted-foreground leading-relaxed">{text}</span>
              </li>
            ))}
          </ul>

          <a
            href="/devis"
            class="inline-flex min-h-12 items-center gap-2 rounded-full bg-primary px-8 py-3 text-base font-bold text-primary-foreground shadow-md transition-all hover:opacity-90"
          >
            Devis gratuit
            <TablerIcon name="arrow-right" class="text-base leading-none" />
          </a>
        </div>
      </div>

      <div class="mt-16 rounded-2xl border border-border bg-panel p-8 sm:p-10">
        <h2 class="font-heading text-h3 text-foreground">Ce qui influence le prix d'un déménagement à Nîmes</h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
          La distance Montpellier-Nîmes reste modérée et n'alourdit pas fortement le prix. Le devis détaille précisément ce qui compose le montant final — aucun chiffre n'est avancé avant d'avoir vu votre situation.
        </p>
        <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {[
            'Volume à transporter (mobilier, cartons, objets volumineux)',
            "Accès aux deux adresses, notamment en centre-ville de Nîmes",
            'Date souhaitée et flexibilité du créneau',
            'Prestations additionnelles (mise en carton, démontage/remontage)',
          ].map((text) => (
            <li class="flex items-start gap-2.5 text-sm text-muted-foreground">
              <TablerIcon name="check" class="mt-0.5 shrink-0 text-base leading-none text-primary" />
              {text}
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-6 border-t border-border pt-12 sm:grid-cols-3">
        {[
          { value: '1 500+', label: 'déménagements réalisés' },
          { value: `${ratingDisplay}/5`, label: 'note Google' },
          { value: '24h', label: 'réponse garantie' },
        ].map(({ value, label }) => (
          <div class="text-center" data-reveal>
            <p class="font-heading text-4xl font-medium text-primary">{value}</p>
            <p class="mt-1 text-sm text-muted-foreground">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FAQSection topper="FAQ Nîmes" heading="Questions sur le déménagement à Nîmes" items={faqItems} />

  <CTA
    title="Votre devis déménageur Nîmes"
    description="Adresses, dates, volume : remplissez le formulaire et recevez un prix fixe garanti sous 24h."
  />
  <Footer slot="footer" />
</BaseLayout>
