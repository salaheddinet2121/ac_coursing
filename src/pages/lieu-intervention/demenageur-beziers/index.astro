---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CTA from '../../../components/CTA.astro';
import FAQSection from '../../../components/FAQSection.astro';
import BofuHero from '../../../components/BofuHero.astro';
import TablerIcon from '../../../components/TablerIcon.astro';
import { client } from '../../../data/client';
import { getPlacesData, formatRating } from '../../../lib/google-places';

const places = await getPlacesData();
const ratingDisplay = formatRating(places.rating);

const faqItems = [
  {
    question: 'Intervenez-vous vraiment à Béziers ou seulement à Montpellier ?',
    answer: "Béziers fait partie de notre zone d'intervention régulière en Occitanie : environ 70 km depuis Montpellier via l'A9, soit 35 à 40 minutes de route. Nos équipes s'y déplacent aussi souvent qu'à Montpellier même.",
    open: true,
  },
  {
    question: "L'accès au centre historique de Béziers pose-t-il problème ?",
    answer: "Le centre-ville de Béziers est construit sur une colline autour de la cathédrale Saint-Nazaire : rues étroites et pentues, accès camion limité par endroits. On anticipe ces contraintes avec vous avant le jour J, avec un stationnement et un créneau de portage adaptés.",
  },
  {
    question: 'Le prix est-il différent pour un déménagement à Béziers ?',
    answer: "La distance Montpellier-Béziers reste modérée et n'alourdit pas fortement le prix. Le volume à transporter et l'accès aux adresses restent les facteurs principaux, comme pour un déménagement local.",
  },
  {
    question: 'Pouvez-vous organiser un déménagement depuis Béziers vers Montpellier ?',
    answer: 'Oui, le trajet fonctionne dans les deux sens. Le devis se construit de la même façon, quel que soit le sens du déménagement.',
  },
];
---

<BaseLayout
  title="Déménageur Béziers | AC Coursing Montpellier"
  description="Déménageur à Béziers depuis Montpellier : équipe locale, prix annoncé = prix payé, devis gratuit sous 24h. Emballage et transport assurés en Occitanie."
  schema={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: 'Déménageur Béziers',
        provider: { '@type': 'MovingCompany', name: client.name, telephone: client.phoneForTel, url: client.domain },
        areaServed: { '@type': 'City', name: 'Béziers' },
        description: "Déménagement à Béziers depuis Montpellier, à environ 70 km via l'A9, prix fixe garanti.",
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${client.domain}/` },
          { '@type': 'ListItem', position: 2, name: 'Services', item: `${client.domain}/services` },
          { '@type': 'ListItem', position: 3, name: 'Déménageur Béziers', item: `${client.domain}/lieu-intervention/demenageur-beziers` },
        ],
      },
    ],
  }}
>
  <Header slot="header" />

  <BofuHero
    crumbs={[
      { label: 'Services', href: '/services' },
      { label: 'Béziers' },
    ]}
    heading="Déménageur à Béziers"
    description="Déménageur à Béziers depuis Montpellier : même équipe, même prix fixe garanti, à environ 70 km via l'A9. Devis gratuit sous 24h, résidentiel ou professionnel."
    points={[
      { icon: 'map-pin', text: "Environ 70 km depuis Montpellier — 35 à 40 minutes via l'A9" },
      { icon: 'truck-delivery', text: 'Équipe locale, même organisation que pour un déménagement à Montpellier' },
      { icon: 'shield-check', text: 'Assurance transport incluse sur tout le trajet' },
      { icon: 'stairs', text: 'Accès au centre historique anticipé (rues pentues et étroites)' },
    ]}
  />

  <section class="bg-background py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16 items-center">

        <div>
          <img
            src="/hero_image.webp"
            alt="Camion AC Coursing prêt pour un déménagement entre Montpellier et Béziers"
            loading="lazy"
            decoding="async"
            class="w-full rounded-2xl border border-border object-cover aspect-[4/3]"
          />
        </div>

        <div class="space-y-6">
          <h2 class="font-heading text-h2 text-foreground">Déménageur à Béziers : une zone d'intervention régulière</h2>
          <p class="text-lg leading-relaxed text-muted-foreground">
            En tant que <a href="/" class="font-semibold text-primary underline underline-offset-2 hover:opacity-80">déménageur à Montpellier</a>, nous intervenons régulièrement à Béziers, au même titre que Montpellier et son agglomération. Le trajet par l'A9 est court, mais l'organisation reste la même : cadrage du volume, créneau confirmé, accès aux deux adresses anticipé.
          </p>
          <p class="leading-relaxed text-muted-foreground">
            Le centre-ville, construit sur une colline autour de la cathédrale Saint-Nazaire, demande une organisation spécifique pour le stationnement du camion et le portage — on la prévoit avec vous en amont.
          </p>

          <a
            href="/devis"
            class="inline-flex min-h-12 items-center gap-2 rounded-full bg-primary px-8 py-3 text-base font-bold text-primary-foreground shadow-md transition-all hover:opacity-90"
          >
            Devis gratuit
            <TablerIcon name="arrow-right" class="text-base leading-none" />
          </a>
        </div>
      </div>

      <div class="mt-16 rounded-2xl border border-border bg-panel p-8 sm:p-10">
        <h3 class="font-heading text-h3 text-foreground">Ce qui influence le prix d'un déménagement à Béziers</h3>
        <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
          La distance Montpellier-Béziers reste modérée et n'alourdit pas fortement le prix. Le devis détaille précisément ce qui compose le montant final — aucun chiffre n'est avancé avant d'avoir vu votre situation.
        </p>
        <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {[
            'Volume à transporter (mobilier, cartons, objets volumineux)',
            "Accès aux deux adresses, notamment en centre-ville de Béziers",
            'Date souhaitée et flexibilité du créneau',
            'Prestations additionnelles (mise en carton, démontage/remontage)',
          ].map((text) => (
            <li class="flex items-start gap-2.5 text-sm text-muted-foreground">
              <TablerIcon name="check" class="mt-0.5 shrink-0 text-base leading-none text-primary" />
              {text}
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-6 border-t border-border pt-12 sm:grid-cols-3">
        {[
          { value: '1 500+', label: 'déménagements réalisés' },
          { value: `${ratingDisplay}/5`, label: 'note Google' },
          { value: '24h', label: 'réponse garantie' },
        ].map(({ value, label }) => (
          <div class="text-center" data-reveal>
            <p class="font-heading text-4xl font-medium text-primary">{value}</p>
            <p class="mt-1 text-sm text-muted-foreground">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FAQSection topper="FAQ Béziers" heading="Questions sur le déménagement à Béziers" items={faqItems} headingLevel="h3" />

  <CTA
    title="Votre devis déménageur Béziers"
    description="Adresses, dates, volume : remplissez le formulaire et recevez un prix fixe garanti sous 24h."
    headingLevel="h3"
  />
  <Footer slot="footer" />
</BaseLayout>
