---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CTA from '../../../components/CTA.astro';
import FAQSection from '../../../components/FAQSection.astro';
import BofuHero from '../../../components/BofuHero.astro';
import RatingInline from '../../../components/RatingInline.astro';
import TablerIcon from '../../../components/TablerIcon.astro';
import { client } from '../../../data/client';
import { cityPhotos } from '../../../data/city-photos';
import { services as serviceLinks, regionalCities, longDistanceRoutes } from '../../../data/prestations';

const city = "Béziers";
const photos = cityPhotos["beziers"];
const steps = [
  {
    "title": "Votre devis sous 24h.",
    "text": "Adresses, étages, ascenseur ou non, date : vous recevez un prix détaillé, poste par poste."
  },
  {
    "title": "On prépare l'accès.",
    "text": "Sur la colline de la cathédrale, on repère où le camion peut s'arrêter et la distance de portage jusqu'à votre porte."
  },
  {
    "title": "Le jour J.",
    "text": "Chargement protégé, transport assuré, installation à l'arrivée. Vous payez le prix du devis."
  }
];
const localProblem = {
  "heading": "Déménager à Béziers : colline, rues étroites et étages sans ascenseur",
  "paragraphs": [
    "Le centre de Béziers est bâti sur une colline, autour de la cathédrale Saint-Nazaire. Les rues y sont étroites, souvent en pente. Le camion ne peut pas toujours se garer devant la porte.",
    "Beaucoup d'immeubles anciens n'ont pas d'ascenseur. On le vérifie au devis pour prévoir le portage et le nombre de bras nécessaires.",
    "Plus bas, aux Allées Paul-Riquet, le stationnement est réglementé. Selon la rue, une demande auprès de la mairie peut être nécessaire."
  ]
};
const neighbourhoods = [
  "Centre ancien",
  "Allées Paul-Riquet",
  "Les Arènes",
  "Montflourès",
  "Saint-Jacques",
  "La Devèze"
];
const formulas = [
  {
    "name": "Formule Économique",
    "text": "Chargement et déchargement par l'équipe, transport assuré, cartons fournis. Adaptée à un appartement avec ascenseur, si vous emballez vous-même."
  },
  {
    "name": "Formule Standard",
    "text": "Avec démontage et remontage des meubles, vaisselle et objets fragiles. Le bon choix dans le centre ancien, où les meubles passent mal les escaliers."
  },
  {
    "name": "Formule Confort",
    "text": "Emballage complet, linge et vêtements compris. Utile pour une maison en périphérie avec beaucoup d'affaires."
  }
];
const formulaIcons = ['truck-delivery', 'package', 'shield-check'];
const guarantees = [
  { icon: 'lock', title: 'Prix fixe', text: 'Le montant du devis validé ne change pas le jour du déménagement.' },
  { icon: 'shield-check', title: 'Assurance transport', text: 'Incluse sur tout le trajet.' },
  { icon: 'calendar', title: 'Créneau confirmé', text: 'À l\'avance, pour le chargement et la livraison.' },
];
const priceFactors = {
  "items": [
    {
      "title": "Le volume",
      "text": "mobilier, cartons, pièces volumineuses."
    },
    {
      "title": "L'accès",
      "text": "rue en pente, étage, ascenseur, stationnement."
    },
    {
      "title": "La date",
      "text": "l'été et les fins de mois demandent plus d'anticipation."
    }
  ],
  "closing": "Le devis détaille chaque poste. Une fois validé, le prix reste celui annoncé."
};
const priceIcons = ['box', 'stairs', 'calendar'];
const tips = [
  "Sur la colline, donnez l'adresse exacte : on repère où le camion peut s'arrêter.",
  "Mesurez l'escalier si vous avez de gros meubles : ils ne passent pas toujours dans les immeubles anciens.",
  "Aux Allées Paul-Riquet, pensez à la demande de stationnement dès que la date est fixée.",
  "En été, chargez tôt le matin : la chaleur est forte dès midi."
];
const faqItems = [
  {
    "question": "Un camion peut-il monter jusqu'au centre ancien de Béziers ?",
    "answer": "Pas toujours jusqu'à la porte. Il s'arrête au point le plus proche et l'équipe porte les meubles. Cette marche supplémentaire est comptée dans le devis."
  },
  {
    "question": "Faut-il réserver une place de stationnement à Béziers ?",
    "answer": "Cela dépend de la rue. Aux Allées Paul-Riquet ou dans le centre, une demande auprès de la mairie peut être nécessaire."
  },
  {
    "question": "Quand réserver un déménagement à Béziers ?",
    "answer": "Dès que la date est fixée, surtout pour l'été et les fins de mois."
  },
  {
    "question": "Quelle formule choisir pour un appartement du centre ancien ?",
    "answer": "La formule Standard convient bien : elle inclut le démontage et le remontage des meubles qui ne passent pas l'escalier."
  }
].map((item) => ({ ...item, open: true }));

// Cards: title and icon come from the shared link data, matched by URL.
const linkIndex = new Map([...serviceLinks, ...regionalCities, ...longDistanceRoutes].map((l) => [l.href, l]));
const toCards = (list: { label: string; href: string }[]) =>
  list.map(({ label, href }) => ({ href, title: linkIndex.get(href)?.title ?? label, icon: linkIndex.get(href)?.icon ?? 'map-pin' }));
const serviceCards = toCards([
  {
    "label": "Déménagement local",
    "href": "/services/demenagement-local"
  },
  {
    "label": "Mise en carton",
    "href": "/services/mise-en-carton"
  },
  {
    "label": "Objets volumineux",
    "href": "/services/objets-volumineux"
  },
  {
    "label": "Déménagement seniors",
    "href": "/services/seniors"
  }
]);
const nearbyCards = toCards([
  {
    "label": "Agde",
    "href": "/lieu-intervention/demenageur-agde"
  },
  {
    "label": "Narbonne",
    "href": "/lieu-intervention/demenageur-narbonne"
  },
  {
    "label": "Montpellier",
    "href": "/"
  }
]);
---

<BaseLayout
  title="Déménageur Béziers (34500) – Devis gratuit sous 24h | AC Coursing"
  description="Déménageur à Béziers : centre ancien, Allées Paul-Riquet, Montflourès. Colline, rues étroites et étages sans ascenseur anticipés, prix fixe garanti. Devis sous 24h."
  schema={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: 'Déménageur Béziers',
        provider: { '@type': 'MovingCompany', name: client.name, telephone: client.phoneForTel, url: client.domain },
        areaServed: { '@type': 'City', name: 'Béziers' },
        description: "Déménagement à Béziers : colline et rues étroites anticipées, prix fixe garanti, assurance transport incluse.",
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${client.domain}/` },
          { '@type': 'ListItem', position: 2, name: 'Services', item: `${client.domain}/services` },
          { '@type': 'ListItem', position: 3, name: 'Déménageur Béziers', item: `${client.domain}/lieu-intervention/demenageur-beziers` },
        ],
      },
    ],
  }}
>
  <Header slot="header" />

  <BofuHero
    crumbs={[
      { label: 'Services', href: '/services' },
      { label: city },
    ]}
    heading="Déménageur à Béziers"
    description="Votre déménagement à Béziers, du centre bâti sur sa colline aux quartiers plus récents, avec un prix fixé dans le devis et garanti jusqu'au jour J."
    points={[
      { icon: "map-pin", text: "Environ 50 min depuis Montpellier par l'A9" },
      { icon: "clock", text: "Devis sous 24h" },
      { icon: "shield-check", text: "Prix fixe garanti" },
      { icon: "truck-delivery", text: "Assurance transport incluse" }
    ]}
    imageSrc={photos.hero.src}
    imageAlt="Le Pont Vieux et la cathédrale Saint-Nazaire à Béziers"
  >
    <RatingInline slot="after-heading" />
  </BofuHero>

  <!-- 4. How it goes -->
  <section class="bg-panel py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="max-w-2xl" data-reveal>
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5">
          <span class="size-2 rounded-full bg-primary" aria-hidden="true"></span>
          <span class="text-topper font-bold uppercase tracking-widest text-primary">En 3 étapes</span>
        </div>
        <h2 class="mt-4 font-heading text-h2 text-foreground">Comment se passe votre déménagement à {city}</h2>
      </div>
      <ol class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-3" role="list">
        {steps.map(({ title, text }, i) => (
          <li class="relative rounded-xl border border-border bg-card p-6" data-reveal style={`transition-delay:${i * 90}ms`}>
            <div class="flex items-center justify-between">
              <span class="flex size-11 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <TablerIcon name={['file-description', 'map-pin', 'truck-delivery'][i]} class="text-xl leading-none" />
              </span>
              <span class="font-heading text-4xl text-input">0{i + 1}</span>
            </div>
            <p class="mt-5 font-heading text-lg font-medium text-foreground">{title}</p>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. The real local problem -->
  <section class="bg-background py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-2 lg:gap-14">
        <div class="space-y-4" data-reveal>
          <h2 class="font-heading text-h2 text-foreground">{localProblem.heading}</h2>
          {localProblem.paragraphs.map((p) => (
            <p class="leading-relaxed text-muted-foreground">{p}</p>
          ))}
        </div>
        <figure class="overflow-hidden rounded-2xl border border-border bg-card" data-reveal>
          <img
            src={photos.local.src}
            alt="La cathédrale Saint-Nazaire de Béziers"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="px-4 py-3 text-xs leading-relaxed text-muted-foreground">
            Photos :
            <a href={photos.hero.source} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-foreground">{photos.hero.author}</a>
            (<a href={photos.hero.licenseUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-foreground">{photos.hero.license}</a>),
            <a href={photos.local.source} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-foreground">{photos.local.author}</a>
            (<a href={photos.local.licenseUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-foreground">{photos.local.license}</a>), Wikimedia Commons.
          </figcaption>
        </figure>
      </div>

      <div class="mt-12 rounded-2xl border border-border bg-panel p-6 sm:p-8" data-reveal>
        <h3 class="font-heading text-h3 text-foreground">Quartiers de {city}</h3>
        <ul class="mt-5 flex flex-wrap gap-2.5" role="list">
          {neighbourhoods.map((n) => (
            <li class="inline-flex items-center gap-1.5 rounded-full border border-border bg-background px-3.5 py-1.5 text-sm text-foreground">
              <TablerIcon name="map-pin" class="text-sm leading-none text-primary" />
              {n}
            </li>
          ))}
        </ul>
      </div>

    </div>
  </section>

  <!-- 7. Formulas -->
  <section class="bg-panel py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="max-w-2xl" data-reveal>
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5">
          <span class="size-2 rounded-full bg-primary" aria-hidden="true"></span>
          <span class="text-topper font-bold uppercase tracking-widest text-primary">Les formules</span>
        </div>
        <h2 class="mt-4 font-heading text-h2 text-foreground">Nos formules à {city}</h2>
      </div>
      <ul class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-3" role="list">
        {formulas.map(({ name, text }, i) => (
          <li
            class:list={[
              'flex flex-col gap-4 rounded-xl border p-7 shadow-sm',
              i === 1 ? 'border-primary/40 bg-primary text-primary-foreground' : 'border-border bg-background',
            ]}
            data-reveal
            style={`transition-delay:${i * 90}ms`}
          >
            <span class:list={['flex size-11 items-center justify-center rounded-lg', i === 1 ? 'bg-primary-foreground/15' : 'bg-primary/10 text-primary']}>
              <TablerIcon name={formulaIcons[i]} class="text-xl leading-none" />
            </span>
            <p class="font-heading text-xl font-medium">{name}</p>
            <p class:list={['flex-1 text-sm leading-relaxed', i === 1 ? 'text-primary-foreground/90' : 'text-muted-foreground']}>{text}</p>
            <a
              href={`/devis?address=${encodeURIComponent(city)}`}
              class:list={[
                'inline-flex min-h-11 items-center justify-center gap-2 rounded-full px-5 text-sm font-bold transition-opacity hover:opacity-90',
                i === 1 ? 'bg-background text-foreground' : 'bg-primary text-primary-foreground',
              ]}
            >
              Choisir ma formule
              <TablerIcon name="arrow-right" class="text-base leading-none" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8 + 9. Guarantees and what sets the price -->
  <section class="bg-card py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <h2 class="font-heading text-h2 text-foreground" data-reveal>Ce qui est garanti</h2>
      <ul class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3" role="list">
        {guarantees.map(({ icon, title, text }, i) => (
          <li class="flex items-start gap-4 rounded-xl border border-border bg-background p-6" data-reveal style={`transition-delay:${i * 90}ms`}>
            <span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
              <TablerIcon name={icon} class="text-xl leading-none" />
            </span>
            <div>
              <p class="font-heading text-lg font-medium text-foreground">{title}</p>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{text}</p>
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-14 rounded-2xl border border-border bg-panel p-6 sm:p-10" data-reveal>
        <h2 class="font-heading text-h2 text-foreground">Ce qui fait le prix d'un déménagement à {city}</h2>
        <ul class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3" role="list">
          {priceFactors.items.map(({ title, text }, i) => (
            <li class="flex items-start gap-3">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-background text-primary ring-1 ring-border">
                <TablerIcon name={priceIcons[i]} class="text-lg leading-none" />
              </span>
              <p class="text-sm leading-relaxed text-muted-foreground"><span class="block font-semibold text-foreground">{title}</span>{text}</p>
            </li>
          ))}
        </ul>
        <p class="mt-8 border-t border-border pt-5 font-medium text-foreground">{priceFactors.closing}</p>
      </div>
    </div>
  </section>

  <!-- 10. Tips -->
  <section class="bg-background py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <h2 class="font-heading text-h2 text-foreground" data-reveal>Nos conseils pour déménager à {city}</h2>
      <ol class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2" role="list">
        {tips.map((tip, i) => (
          <li class="flex items-start gap-4 rounded-xl border border-border bg-card p-6" data-reveal style={`transition-delay:${i * 70}ms`}>
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-primary-foreground">{i + 1}</span>
            <p class="leading-relaxed text-muted-foreground">{tip}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 11. FAQ -->
  <FAQSection topper={`FAQ ${city}`} heading="Questions fréquentes" items={faqItems} />

  <!-- 12 + 13. Services and nearby towns, as cards -->
  <section class="bg-background py-section">
    <div class="mx-auto max-w-site space-y-14 px-4 sm:px-6">
      <div data-reveal>
        <h2 class="font-heading text-h3 text-foreground">Nos services</h2>
        <ul class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
          {serviceCards.map(({ title, icon, href }) => (
            <li>
              <a href={href} class="group flex h-full items-center gap-4 rounded-xl border border-border bg-card p-5 transition-all hover:border-primary/40 hover:shadow-md">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
                  <TablerIcon name={icon} class="text-lg leading-none" />
                </span>
                <span class="flex-1 font-semibold text-foreground">{title}</span>
                <TablerIcon name="chevron-right" class="text-base leading-none text-muted-foreground transition-transform group-hover:translate-x-0.5 group-hover:text-primary" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div data-reveal>
        <h2 class="font-heading text-h3 text-foreground">Nous intervenons aussi à proximité</h2>
        <ul class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
          {nearbyCards.map(({ title, icon, href }) => (
            <li>
              <a href={href} class="group flex h-full items-center gap-4 rounded-xl border border-border bg-card p-5 transition-all hover:border-primary/40 hover:shadow-md">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
                  <TablerIcon name={icon} class="text-lg leading-none" />
                </span>
                <span class="flex-1 font-semibold text-foreground">{title}</span>
                <TablerIcon name="chevron-right" class="text-base leading-none text-muted-foreground transition-transform group-hover:translate-x-0.5 group-hover:text-primary" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 14. CTA -->
  <CTA
    title="Votre devis pour un déménagement à Béziers"
    description="Adresse, étage, date souhaitée : le formulaire prend quelques minutes."
    buttonText="Obtenir mon devis gratuit"
    headingLevel="h2"
  />
  <Footer slot="footer" />
</BaseLayout>
