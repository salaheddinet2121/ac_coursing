---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CTA from '../../../components/CTA.astro';
import FAQSection from '../../../components/FAQSection.astro';
import BofuHero from '../../../components/BofuHero.astro';
import TablerIcon from '../../../components/TablerIcon.astro';
import { client } from '../../../data/client';
import { getPlacesData, formatRating } from '../../../lib/google-places';

const places = await getPlacesData();
const ratingDisplay = formatRating(places.rating);

const faqItems = [
  {
    question: 'Combien de temps prend un déménagement Montpellier-Marseille ?',
    answer: "Comptez environ 170 km et 1h30 à 2h de route par l'A9 puis l'A7. C'est le plus court de nos trajets longue distance réguliers — plus proche d'un déménagement régional que d'un long trajet.",
    open: true,
  },
  {
    question: 'Ce trajet est-il vraiment une longue distance ?',
    answer: "Honnêtement, Marseille est nettement plus proche que Lyon ou Toulouse. L'organisation reste néanmoins celle d'un vrai déménagement inter-villes : chargement, transport, livraison, avec un interlocuteur unique du départ à l'arrivée.",
  },
  {
    question: 'Le prix dépend-il de la distance ou du volume ?',
    answer: "Les deux : la distance Montpellier-Marseille fixe une base de trajet plus légère que sur les autres routes longue distance, et le volume à transporter ajuste le prix final. Le devis détaille chaque poste.",
  },
  {
    question: 'Peut-on avoir un déménagement urgent vers Marseille ?',
    answer: "Oui, la proximité de Marseille facilite justement les créneaux rapprochés. Plus la date est communiquée tôt, plus il est simple de sécuriser un créneau et le bon véhicule.",
  },
];
---

<BaseLayout
  title="Déménagement Montpellier-Marseille | AC Coursing"
  description="Déménagement Montpellier-Marseille organisé de bout en bout : transport direct par l'A9 puis l'A7, prix fixe garanti. Devis gratuit sous 24h."
  schema={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: 'Déménagement Montpellier-Marseille',
        provider: { '@type': 'MovingCompany', name: client.name, telephone: client.phoneForTel, url: client.domain },
        areaServed: [
          { '@type': 'City', name: 'Montpellier' },
          { '@type': 'City', name: 'Marseille' },
        ],
        description: 'Déménagement entre Montpellier et Marseille, transport direct et prix fixe garanti.',
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${client.domain}/` },
          { '@type': 'ListItem', position: 2, name: 'Prestations', item: `${client.domain}/prestations/` },
          { '@type': 'ListItem', position: 3, name: 'Déménagement Montpellier-Marseille', item: `${client.domain}/lieu-intervention/demenagement-montpellier-marseille/` },
        ],
      },
    ],
  }}
>
  <Header slot="header" />

  <BofuHero
    crumbs={[
      { label: 'Prestations', href: '/prestations' },
      { label: 'Montpellier - Marseille' },
    ]}
    heading="Déménagement Montpellier-Marseille"
    description="Environ 170 km par l'A9 puis l'A7, le plus court de nos trajets longue distance réguliers, avec un interlocuteur unique du départ à la livraison."
    points={[
      { icon: 'map-pin', text: "Environ 170 km — Montpellier ↔ Marseille via l'A9 puis l'A7" },
      { icon: 'truck-delivery', text: 'Transport dédié, sans rupture de charge' },
      { icon: 'shield-check', text: 'Assurance transport incluse sur toute la distance du trajet' },
      { icon: 'calendar', text: "Créneau de chargement et de livraison confirmé à l'avance" },
    ]}
  />

  <section class="bg-background py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16 items-center">

        <div>
          <img
            src="/hero_image.webp"
            alt="Camion AC Coursing chargé pour un déménagement vers Marseille"
            loading="lazy"
            decoding="async"
            class="w-full rounded-2xl border border-border object-cover aspect-[4/3]"
          />
        </div>

        <div class="space-y-6">
          <h2 class="font-heading text-h2 text-foreground">Le plus court de nos trajets longue distance</h2>
          <p class="text-lg leading-relaxed text-muted-foreground">
            En tant que <a href="/" class="font-semibold text-primary underline underline-offset-2 hover:opacity-80">déménageur à Montpellier</a>, nous organisons régulièrement des trajets vers Marseille. À environ 170 km, c'est le plus court de nos trajets longue distance réguliers — plus proche d'un déménagement régional que d'un long trajet — mais l'organisation reste celle d'un vrai déménagement inter-villes.
          </p>
          <p class="leading-relaxed text-muted-foreground">
            Itinéraire, créneau de chargement et contraintes d'accès aux deux adresses sont cadrés avant le jour J, comme sur nos autres trajets.
          </p>

          <a
            href="/devis"
            class="inline-flex min-h-12 items-center gap-2 rounded-full bg-primary px-8 py-3 text-base font-bold text-primary-foreground shadow-md transition-all hover:opacity-90"
          >
            Devis gratuit
            <TablerIcon name="arrow-right" class="text-base leading-none" />
          </a>
        </div>
      </div>

      <div class="mt-16 rounded-2xl border border-border bg-panel p-8 sm:p-10">
        <h3 class="font-heading text-h3 text-foreground">Ce qui influence le prix d'un Montpellier-Marseille</h3>
        <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
          Ce trajet plus court reste malgré tout dépendant du volume à transporter et des contraintes d'accès. Le devis détaille précisément ce qui compose le prix final — aucun montant n'est avancé avant d'avoir vu votre situation.
        </p>
        <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {[
            'Volume à transporter (mobilier, cartons, objets volumineux)',
            'Accès aux deux adresses (étage, ascenseur, stationnement)',
            'Date souhaitée et flexibilité du créneau',
            'Prestations additionnelles (mise en carton, démontage/remontage)',
          ].map((text) => (
            <li class="flex items-start gap-2.5 text-sm text-muted-foreground">
              <TablerIcon name="check" class="mt-0.5 shrink-0 text-base leading-none text-primary" />
              {text}
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-6 border-t border-border pt-12 sm:grid-cols-3">
        {[
          { value: '1 500+', label: 'déménagements réalisés' },
          { value: `${ratingDisplay}/5`, label: 'note Google' },
          { value: '24h', label: 'réponse garantie' },
        ].map(({ value, label }) => (
          <div class="text-center" data-reveal>
            <p class="font-heading text-4xl font-medium text-primary">{value}</p>
            <p class="mt-1 text-sm text-muted-foreground">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FAQSection topper="FAQ Montpellier-Marseille" heading="Questions sur ce trajet" items={faqItems} headingLevel="h3" />

  <CTA
    title="Votre devis Montpellier-Marseille en 4 étapes"
    description="Adresses, dates, volume : remplissez le formulaire et recevez un prix fixe garanti sous 24h."
    headingLevel="h3"
  />
  <Footer slot="footer" />
</BaseLayout>
