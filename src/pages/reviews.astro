---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import TablerIcon from '../components/TablerIcon.astro';
import { brand } from '../config/brand';
import { client } from '../data/client';
import { getPlacesData, formatRating } from '../lib/google-places';

const places = await getPlacesData();
const ratingDisplay = formatRating(places.rating);

const reviews = [
  { quote: "Walid et Abdelhak ont réalisé notre déménagement et c'était parfait du début à la fin ! Très polis, professionnels et chaleureux, ils ont fait preuve d'une grande attention dans le transport. Ils ont même insisté pour raccorder la machine à laver et pour installer le matelas proprement. Je recommande les yeux fermés !", name: 'Enzo C.', location: 'Avis Google · juillet', rating: 5 },
  { quote: "Très grand merci à cette société qui m'a sauvé dimanche. J'avais engagé une autre entreprise de déménagement, ils ont pris mon acompte et depuis plus de nouvelles. J'ai appelé AC Coursing, je suis tombé sur le patron, je lui ai expliqué mon cas…", name: 'Marc Sammartano', location: 'Avis Google · juillet', rating: 5 },
  { quote: "Un immense merci à toute l'équipe, et tout particulièrement à Walid, pour leur professionnalisme et leur gentillesse.", name: 'Marion Cavallier', location: 'Avis Google · juin', rating: 5 },
  { quote: "Une expérience exceptionnelle du début à la fin ! L'équipe AC Coursing a été ponctuelle, professionnelle, efficace et très soigneuse avec toutes nos affaires.", name: 'Valérie Germon', location: 'Avis Google · juillet', rating: 5 },
  { quote: "Franchement un super déménagement avec AC Coursing. L'équipe a été ponctuelle, efficace et surtout très humaine. Ils ont pris soin de tous les meubles et ont travaillé dans la bonne humeur du début à la fin.", name: 'Driss Rafiq', location: 'Avis Google · février', rating: 5 },
  { quote: "J'ai fait appel à AC Coursing pour mon déménagement le mardi 14 octobre. Tout s'est vraiment bien passé et les professionnels ont été très efficaces ! Tout a été bien rangé et soigneusement emballé.", name: 'Anaïs Foulu', location: 'Avis Google · octobre', rating: 5 },
  { quote: 'Très satisfaits de notre déménagement avec AC Coursing. Rapides, efficaces et soigneux, le tout à un prix très raisonnable. Je recommande !', name: 'Justine Chiquet', location: 'Avis Google · août', rating: 5 },
  { quote: "Très bonne expérience pour mon déménagement. Walid était sérieux, efficace et à l'écoute. Il a pris le temps de bien protéger les meubles et de tout installer correctement dans mon nouveau logement. Le service est vraiment de qualité.", name: 'Sègbéou David Zannou', location: 'Avis Google · mars', rating: 5 },
  { quote: 'Une entreprise et son équipe compétente avec une écoute attentive de nos besoins, pour le déménagement de notre établissement de 3000 m² et tout son mobilier et matériels.', name: 'Isabelle Donati', location: 'Avis Google · février', rating: 5 },
  { quote: "Déménageurs rapides, efficaces et très ponctuels. Tout a été parfaitement géré dans les temps, avec beaucoup de professionnalisme. En plus d'être respectueux, ils ont été très gentils et agréables tout au long du déménagement. Je recommande sans hésiter !", name: 'Sofia Sigh', location: 'Avis Google · mai', rating: 5 },
];
---

<BaseLayout
  title={`Avis clients — ${brand.name} Montpellier`}
  description={`${places.reviewCount} avis Google vérifiés pour AC Coursing. Fiabilité, ponctualité et prix clairs : découvrez pourquoi nos clients nous recommandent à Montpellier.`}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'MovingCompany',
    name: client.name,
    telephone: client.phoneForTel,
    url: client.domain,
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: String(places.rating),
      reviewCount: String(places.reviewCount),
      bestRating: '5',
    },
  }}
>
  <Header slot="header" />

  <Banner title="Avis" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="font-heading text-h2 text-text">Ce que disent les clients</h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          Plus de {places.reviewCount} avis vérifiés sur Google. Fiabilité, ponctualité et prix clairs: ce que nos clients retiennent systématiquement.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {reviews.map(({ quote, name, location, rating = 5 }) => (
          <div class="flex flex-col rounded-lg border border-border bg-background p-6">
            <div class="mb-4 flex gap-1" aria-label={`Noté ${rating} sur 5`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <TablerIcon name="star-filled" class:list={['text-xl leading-none', i < rating ? 'text-primary' : 'text-border']} />
              ))}
            </div>
            <blockquote class="flex-1 text-text-muted leading-relaxed">&ldquo;{quote}&rdquo;</blockquote>
            <div class="mt-4 border-t border-border pt-4">
              <p class="font-semibold text-text">{name}</p>
              <p class="text-sm text-text-muted">{location}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
