---
import TablerIcon from './TablerIcon.astro';

interface Props {
  topper?: string;
  heading?: string;
  body?: string[];
  benefits?: string[];
  ctaLabel?: string;
  ctaHref?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  topper   = 'Notre structure',
  heading  = 'Une équipe cadrée, un interlocuteur unique',
  body = [
    "AC Coursing accompagne les déménagements à Montpellier depuis 2015 : résidentiel, longue distance, garde-meubles et transferts professionnels.",
    "Notre approche tient en une phrase: un cadrage précis et un devis <em>fixe</em>, pour un déménagement maîtrisé du début à la fin.",
  ],
  benefits = [
    "Ponctualité et équipe joignable avant, pendant et après l'intervention.",
    'Prix annoncé = prix facturé, sauf changement de périmètre validé avec vous.',
    'Protection du mobilier, assurance transport et soin sur les objets fragiles.',
  ],
  ctaLabel = 'Devis gratuit',
  ctaHref  = '/devis',
  imageSrc = '/images/residentiel/residentiel-04.webp',
  imageAlt = 'Installation et remise en place du mobilier dans un appartement — AC Coursing Montpellier',
} = Astro.props;
---

<section id="a-propos" class="bg-dark py-section">
  <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">

    <!-- Image -->
    <div class="relative overflow-hidden rounded-xl border border-primary-fg/15 bg-dark-surface shadow-lg">
      <img
        src={imageSrc}
        alt={imageAlt}
        loading="lazy"
        decoding="async"
        class="size-full object-cover"
      />
    </div>

    <!-- Content -->
    <div class="space-y-5">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary-soft/30 bg-primary-soft/10 px-4 py-1.5">
        <span class="size-2 rounded-full bg-primary-soft"></span>
        <span class="text-topper font-bold uppercase tracking-widest text-primary-soft">{topper}</span>
      </div>

      <h2 class="font-heading text-h2 text-primary-fg">{heading}</h2>

      {body.map((paragraph) => (
        <p class="leading-relaxed text-primary-fg/60" set:html={paragraph} />
      ))}

      <ul class="space-y-2.5 pt-1" role="list">
        {benefits.map((benefit) => (
          <li class="text-primary-fg/80">{benefit}</li>
        ))}
      </ul>

      <div class="pt-2">
        <a
          href={ctaHref}
          class="inline-flex min-h-12 items-center gap-2 rounded-full bg-primary px-7 py-3 text-base font-bold text-primary-foreground shadow-md transition-all hover:opacity-90 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {ctaLabel}
          <TablerIcon name="arrow-right" class="text-base leading-none" />
        </a>
      </div>
    </div>

  </div>
</section>
