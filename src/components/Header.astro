---
import { brand } from '../config/brand';
import { client } from '../data/client';
import TablerIcon from './TablerIcon.astro';
import { services, regionalCities, longDistanceRoutes } from '../data/prestations';

const nav = [
  { label: 'Accueil', href: '/' },
  { label: 'Galerie',  href: '/galerie' },
  { label: 'Avis',     href: '/reviews' },
  { label: 'Contact',  href: '/contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const path = href.split('#')[0] || '/';
  return path === currentPath || (path !== '/' && currentPath.startsWith(path));
};
const isServicesActive = isActive('/services');
const isLieuActive = isActive('/lieu-intervention');
---

<header class="sticky top-0 z-50 w-full border-b border-border/60 bg-background/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-site items-center justify-between gap-6 px-4 py-0 sm:px-6">

    <!-- Logo -->
    <a href="/" class="shrink-0 py-3 transition-opacity hover:opacity-80" aria-label={brand.name}>
      <img
        src="/logo/full_logo.svg"
        alt={brand.name}
        class="h-10 w-auto"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigation principale">
      <a
        href={nav[0].href}
        aria-current={isActive(nav[0].href) ? 'page' : undefined}
        class:list={[
          'relative flex items-center min-h-11 px-3 text-sm font-medium rounded-lg transition-colors',
          isActive(nav[0].href)
            ? 'text-primary bg-primary/8'
            : 'text-foreground/70 hover:text-foreground hover:bg-muted',
        ]}
      >
        {nav[0].label}
      </a>

      <!-- Services dropdown -->
      <div class="group relative pb-2 -mb-2" data-dropdown="services">
        <button
          type="button"
          data-trigger
          aria-expanded="false"
          aria-controls="services-panel"
          class:list={[
            'relative flex items-center gap-1 min-h-11 px-3 text-sm font-medium rounded-lg transition-colors',
            isServicesActive
              ? 'text-primary bg-primary/8'
              : 'text-foreground/70 hover:text-foreground hover:bg-muted',
          ]}
        >
          Services
          <TablerIcon data-chevron name="chevron-down" stroke={1.5} class="relative top-px size-2.5 shrink-0 opacity-60 transition-transform duration-300 group-hover:rotate-180" />
        </button>

        <div
          id="services-panel"
          data-panel
          class="invisible absolute left-1/2 top-full z-50 -translate-x-1/2 rounded-2xl border border-border bg-card p-5 opacity-0 shadow-lg transition-opacity duration-150 group-hover:visible group-hover:opacity-100"
        >
          <div class="mb-3 flex items-center justify-between gap-6">
            <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Nos services</p>
            <a href="/services" class="text-xs font-medium text-muted-foreground transition-colors hover:text-foreground">Voir tout</a>
          </div>
          <ul class="grid w-max grid-cols-2 gap-x-6 gap-y-0.5">
            {services.map(({ title, icon, href }) => (
              <li>
                <a href={href} class="group/item flex items-center gap-3 whitespace-nowrap rounded-lg px-2 py-1.5 text-sm text-foreground/80 transition-colors hover:bg-muted/40">
                  <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted p-1.5 text-foreground/70 transition-colors group-hover/item:bg-border">
                    <TablerIcon name={icon} class="text-sm leading-none" />
                  </span>
                  <span class="font-medium">{title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Lieu d'intervention dropdown -->
      <div class="group relative pb-2 -mb-2" data-dropdown="lieu">
        <button
          type="button"
          data-trigger
          aria-expanded="false"
          aria-controls="lieu-panel"
          class:list={[
            'relative flex items-center gap-1 min-h-11 whitespace-nowrap px-3 text-sm font-medium rounded-lg transition-colors',
            isLieuActive
              ? 'text-primary bg-primary/8'
              : 'text-foreground/70 hover:text-foreground hover:bg-muted',
          ]}
        >
          Lieu d'intervention
          <TablerIcon data-chevron name="chevron-down" stroke={1.5} class="relative top-px size-2.5 shrink-0 opacity-60 transition-transform duration-300 group-hover:rotate-180" />
        </button>

        <div
          id="lieu-panel"
          data-panel
          class="invisible absolute left-1/2 top-full z-50 -translate-x-1/2 rounded-2xl border border-border bg-card p-5 opacity-0 shadow-lg transition-opacity duration-150 group-hover:visible group-hover:opacity-100"
        >
          <div class="flex items-stretch gap-6">
            <div class="w-max border-r border-border pr-6">
              <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Occitanie</p>
              <ul>
                {regionalCities.map(({ title, icon, href }) => (
                  <li>
                    <a href={href} class="group/item flex items-center gap-3 whitespace-nowrap rounded-lg px-2 py-1.5 text-sm text-foreground/80 transition-colors hover:bg-muted/40">
                      <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted p-1.5 text-foreground/70 transition-colors group-hover/item:bg-border">
                        <TablerIcon name={icon} class="text-sm leading-none" />
                      </span>
                      <span class="font-medium">{title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <div class="flex w-max flex-col">
              <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Longue distance</p>
              <ul>
                {longDistanceRoutes.map(({ title, icon, href }) => (
                  <li>
                    <a href={href} class="group/item flex items-center gap-3 whitespace-nowrap rounded-lg px-2 py-1.5 text-sm text-foreground/80 transition-colors hover:bg-muted/40">
                      <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted p-1.5 text-foreground/70 transition-colors group-hover/item:bg-border">
                        <TablerIcon name={icon} class="text-sm leading-none" />
                      </span>
                      <span class="font-medium">{title}</span>
                    </a>
                  </li>
                ))}
              </ul>

              <div class="mt-auto flex flex-col gap-2 rounded-xl bg-primary/8 p-4">
                <TablerIcon name="map-pin" class="text-lg leading-none text-primary" />
                <p class="text-sm font-semibold text-foreground">Une autre destination ?</p>
                <p class="text-xs leading-relaxed text-muted-foreground">
                  Nous intervenons partout en France, prix fixe garanti.
                </p>
                <a
                  href="/devis"
                  class="mt-1 inline-flex items-center gap-1.5 text-sm font-semibold text-primary transition-opacity hover:opacity-80"
                >
                  Devis gratuit
                  <TablerIcon name="arrow-right" class="text-sm leading-none" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      {nav.slice(1).map(({ label, href }) => (
        <a
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
          class:list={[
            'relative flex items-center min-h-11 px-3 text-sm font-medium rounded-lg transition-colors',
            isActive(href)
              ? 'text-primary bg-primary/8'
              : 'text-foreground/70 hover:text-foreground hover:bg-muted',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- Desktop actions -->
    <div class="hidden items-center gap-3 lg:flex">
      <a
        href={`tel:${client.phoneForTel}`}
        class="flex items-center gap-2 rounded-full border border-border px-4 py-2 text-sm font-semibold text-foreground transition-colors hover:border-primary/40 hover:text-primary"
      >
        <TablerIcon name="phone" class="text-base leading-none text-primary" />
        {client.phoneFormatted}
      </a>
      <a
        href="/devis"
        class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-bold text-primary-foreground shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        Devis gratuit
        <TablerIcon name="arrow-right" class="text-sm leading-none" />
      </a>
    </div>

    <!-- Mobile burger -->
    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex size-10 items-center justify-center rounded-lg text-foreground/70 transition-colors hover:bg-muted lg:hidden"
    >
      <span class="sr-only">Ouvrir le menu</span>
      <span id="menu-icon-open"><TablerIcon name="menu-2" class="text-xl leading-none" /></span>
      <span id="menu-icon-close" class="hidden"><TablerIcon name="x" class="text-xl leading-none" /></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-border bg-background px-4 pb-6 pt-3 lg:hidden">
    <nav class="flex flex-col gap-0.5" aria-label="Navigation mobile">
      <a
        href={nav[0].href}
        class:list={[
          'rounded-xl px-4 py-3 text-[0.95rem] font-medium transition-colors',
          isActive(nav[0].href)
            ? 'bg-primary/10 text-primary font-semibold'
            : 'text-foreground/70 hover:bg-muted hover:text-foreground',
        ]}
      >
        {nav[0].label}
      </a>

      <details class="group rounded-xl" open={isServicesActive}>
        <summary
          class:list={[
            'flex cursor-pointer list-none items-center justify-between gap-2 rounded-xl px-4 py-3 text-[0.95rem] font-medium transition-colors [&::-webkit-details-marker]:hidden',
            isServicesActive
              ? 'bg-primary/10 text-primary font-semibold'
              : 'text-foreground/70 hover:bg-muted hover:text-foreground',
          ]}
        >
          Services
          <TablerIcon name="chevron-right" class="size-3.5 shrink-0 opacity-60 transition-transform group-open:rotate-90" />
        </summary>
        <div class="pb-2 pl-4">
          <div class="mb-1 mt-2 flex items-center justify-between gap-2 px-2">
            <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Nos services</p>
            <a href="/services" class="text-xs font-medium text-muted-foreground">Voir tout</a>
          </div>
          {services.map(({ title, icon, href }) => (
            <a href={href} class="flex items-center gap-2.5 rounded-lg px-2 py-2.5 text-sm text-foreground/70 transition-colors hover:bg-muted hover:text-foreground">
              <span class="flex size-7 shrink-0 items-center justify-center rounded-md bg-muted text-foreground/70">
                <TablerIcon name={icon} class="text-sm leading-none" />
              </span>
              {title}
            </a>
          ))}
        </div>
      </details>

      <details class="group rounded-xl" open={isLieuActive}>
        <summary
          class:list={[
            'flex cursor-pointer list-none items-center justify-between gap-2 rounded-xl px-4 py-3 text-[0.95rem] font-medium transition-colors [&::-webkit-details-marker]:hidden',
            isLieuActive
              ? 'bg-primary/10 text-primary font-semibold'
              : 'text-foreground/70 hover:bg-muted hover:text-foreground',
          ]}
        >
          Lieu d'intervention
          <TablerIcon name="chevron-right" class="size-3.5 shrink-0 opacity-60 transition-transform group-open:rotate-90" />
        </summary>
        <div class="pb-2 pl-4">
          <p class="mb-1 mt-2 px-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Occitanie</p>
          {regionalCities.map(({ title, icon, href }) => (
            <a href={href} class="flex items-center gap-2.5 rounded-lg px-2 py-2.5 text-sm text-foreground/70 transition-colors hover:bg-muted hover:text-foreground">
              <span class="flex size-7 shrink-0 items-center justify-center rounded-md bg-muted text-foreground/70">
                <TablerIcon name={icon} class="text-sm leading-none" />
              </span>
              {title}
            </a>
          ))}
          <p class="mb-1 mt-3 px-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Longue distance</p>
          {longDistanceRoutes.map(({ title, icon, href }) => (
            <a href={href} class="flex items-center gap-2.5 rounded-lg px-2 py-2.5 text-sm text-foreground/70 transition-colors hover:bg-muted hover:text-foreground">
              <span class="flex size-7 shrink-0 items-center justify-center rounded-md bg-muted text-foreground/70">
                <TablerIcon name={icon} class="text-sm leading-none" />
              </span>
              {title}
            </a>
          ))}
        </div>
      </details>

      {nav.slice(1).map(({ label, href }) => (
        <a
          href={href}
          class:list={[
            'rounded-xl px-4 py-3 text-[0.95rem] font-medium transition-colors',
            isActive(href)
              ? 'bg-primary/10 text-primary font-semibold'
              : 'text-foreground/70 hover:bg-muted hover:text-foreground',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>

    <div class="mt-4 flex flex-col gap-3 border-t border-border pt-4">
      <a
        href={`tel:${client.phoneForTel}`}
        class="flex items-center justify-center gap-2 rounded-full border border-border py-3 text-[0.95rem] font-semibold text-foreground transition-colors hover:border-primary/40 hover:text-primary"
      >
        <TablerIcon name="phone" class="text-base leading-none text-primary" />
        {client.phoneFormatted}
      </a>
      <a
        href="/devis"
        class="flex items-center justify-center gap-2 rounded-full bg-primary py-3 text-[0.95rem] font-bold text-primary-foreground shadow-sm transition-opacity hover:opacity-90"
      >
        Devis gratuit
        <TablerIcon name="arrow-right" class="text-sm leading-none" />
      </a>
    </div>
  </div>
</header>

<script>
  (() => {
    let menuOpen = false;
    const openDropdowns = new Set<string>();

    const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;

    const getMenuEls = () => ({
      btn:       document.getElementById('menu-toggle') as HTMLButtonElement | null,
      menu:      document.getElementById('mobile-menu') as HTMLElement | null,
      iconOpen:  document.getElementById('menu-icon-open') as HTMLElement | null,
      iconClose: document.getElementById('menu-icon-close') as HTMLElement | null,
    });

    const getDropdowns = () =>
      Array.from(document.querySelectorAll<HTMLElement>('[data-dropdown]')).map((el) => ({
        key:     el.dataset.dropdown!,
        trigger: el.querySelector<HTMLButtonElement>('[data-trigger]'),
        panel:   el.querySelector<HTMLElement>('[data-panel]'),
        chevron: el.querySelector<HTMLElement>('[data-chevron]'),
      }));

    const setOpen = (next: boolean) => {
      const { btn, menu, iconOpen, iconClose } = getMenuEls();
      if (!btn || !menu) return;
      menuOpen = isDesktop() ? false : next;
      btn.setAttribute('aria-expanded', String(menuOpen));
      menu.classList.toggle('hidden', !menuOpen);
      iconOpen?.classList.toggle('hidden', menuOpen);
      iconClose?.classList.toggle('hidden', !menuOpen);
    };

    const setDropdownOpen = (key: string, next: boolean) => {
      const dropdown = getDropdowns().find((d) => d.key === key);
      if (!dropdown?.trigger || !dropdown.panel) return;
      next ? openDropdowns.add(key) : openDropdowns.delete(key);
      dropdown.trigger.setAttribute('aria-expanded', String(next));
      dropdown.panel.classList.toggle('invisible', !next);
      dropdown.panel.classList.toggle('opacity-0', !next);
      dropdown.chevron?.classList.toggle('rotate-180', next);
    };

    const closeAllDropdowns = () => {
      getDropdowns().forEach((d) => setDropdownOpen(d.key, false));
    };

    const syncLinks = () => {
      const { menu } = getMenuEls();
      if (!menu) return;
      const path = window.location.pathname;
      menu.querySelectorAll<HTMLAnchorElement>('nav a').forEach((link) => {
        let href = link.getAttribute('href') || '';
        try { href = new URL(href, location.origin).pathname; } catch {}
        const active = href === path || (href !== '/' && path.startsWith(href));
        link.classList.toggle('bg-primary/10', active);
        link.classList.toggle('text-primary', active);
        link.classList.toggle('font-semibold', active);
        link.classList.toggle('text-foreground/70', !active);
        active ? link.setAttribute('aria-current', 'page') : link.removeAttribute('aria-current');
      });
    };

    // Single click handler on document — no per-init listener accumulation
    document.addEventListener('click', (e) => {
      const target = e.target as Element;
      if (target.closest('#menu-toggle')) {
        setOpen(!menuOpen);
      } else if (menuOpen && !target.closest('#mobile-menu')) {
        setOpen(false);
      } else if (menuOpen && target.closest('#mobile-menu a[href]')) {
        setOpen(false);
      }

      getDropdowns().forEach(({ key }) => {
        const wrapper = target.closest<HTMLElement>(`[data-dropdown="${key}"]`);
        const isOpen = openDropdowns.has(key);
        if (target.closest(`[data-dropdown="${key}"] [data-trigger]`)) {
          setDropdownOpen(key, !isOpen);
        } else if (isOpen && target.closest(`[data-dropdown="${key}"] [data-panel] a[href]`)) {
          setDropdownOpen(key, false);
        } else if (isOpen && !wrapper) {
          setDropdownOpen(key, false);
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllDropdowns();
        if (menuOpen) setOpen(false);
      }
    });

    window.addEventListener('resize', () => { if (isDesktop()) setOpen(false); closeAllDropdowns(); }, { passive: true });
    document.addEventListener('astro:before-preparation', () => { setOpen(false); closeAllDropdowns(); });
    document.addEventListener('astro:after-swap', () => { setOpen(false); closeAllDropdowns(); syncLinks(); });

    setOpen(false);
    closeAllDropdowns();
    syncLinks();
  })();
</script>
