---
import { client } from '../data/client';
import TablerIcon from './TablerIcon.astro';

interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
  headingLevel?: 'h2' | 'h3';
}

const {
  title       = 'Votre estimation en 4 étapes, en moins de 2 minutes.',
  description = 'Remplissez notre formulaire de devis pour votre déménagement à Montpellier : réponse avec un prix fixe garanti sous 24h.',
  buttonText  = 'Devis gratuit',
  buttonHref  = '/devis',
  headingLevel = 'h2',
} = Astro.props;
const Heading = headingLevel;
---

<section class="bg-background py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div
      class="flex flex-col items-center gap-8 rounded-hero border border-primary/20 bg-primary/5 p-8 text-center md:flex-row md:items-center md:justify-between md:gap-10 md:p-12 md:text-left"
      data-reveal
    >
      <div class="flex flex-col items-center gap-5 md:flex-row md:gap-6">
        <span class="flex size-14 shrink-0 items-center justify-center rounded-xl bg-primary/15 text-primary">
          <TablerIcon name="truck-delivery" class="text-2xl leading-none" />
        </span>
        <div>
          <Heading class="font-heading text-h2 text-foreground">{title}</Heading>
          <p class="mt-2 max-w-xl leading-relaxed text-muted-foreground">{description}</p>
        </div>
      </div>

      <div class="flex w-full flex-col items-center gap-3 shrink-0 sm:w-auto sm:flex-row">
        <a
          href={buttonHref}
          class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-primary px-8 py-3 text-base font-bold text-primary-foreground shadow-md transition-all hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:w-auto"
        >
          {buttonText}
        </a>
        <a
          href={`tel:${client.phoneForTel}`}
          class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full border-2 border-border bg-background px-8 py-3 text-base font-bold text-foreground transition-all hover:border-primary/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:w-auto"
        >
          <TablerIcon name="phone" class="text-xl leading-none" />
          {client.phoneFormatted}
        </a>
      </div>
    </div>

    <p class="mt-5 text-center text-sm text-muted-foreground">
      100&nbsp;% gratuit &middot; Sans engagement &middot; Réponse garantie sous 24h
    </p>
  </div>
</section>
