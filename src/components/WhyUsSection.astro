---
import TablerIcon from './TablerIcon.astro';

interface Props {
  topper?: string;
  headingStrong?: string;
  headingItalic?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  topper        = 'Pour vous',
  headingStrong = 'Votre déménagement,',
  headingItalic = 'géré avec sérieux.',
  description   = "Un interlocuteur unique du premier appel à la remise des clés, pour un déménagement à Montpellier organisé du début à la fin.",
  ctaLabel      = 'Devis gratuit',
  ctaHref       = '/devis',
  imageSrc      = '/images/akh_walid.webp',
  imageAlt      = "Équipe AC Coursing prête pour votre déménagement",
} = Astro.props;
---

<section id="garanties" class="bg-panel py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">

    <!-- Top split: content left / image right -->
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">

      <!-- Left -->
      <div data-reveal>
        <div class="inline-flex items-center gap-2.5">
          <span class="size-2 rounded-full bg-primary" aria-hidden="true"></span>
          <span class="text-topper font-bold uppercase tracking-widest text-primary">{topper}</span>
        </div>

        <h2 class="mt-5 font-heading text-h1 leading-tight text-foreground">
          {headingStrong}<br />
          <span class="font-normal not-italic text-muted-foreground">{headingItalic}</span>
        </h2>

        <p class="mt-4 max-w-md leading-relaxed text-muted-foreground">{description}</p>

        <a
          href={ctaHref}
          class="btn-premium mt-8 inline-flex min-h-12 items-center gap-2 rounded-full bg-primary px-8 py-3 text-base font-bold text-primary-foreground shadow-md transition-all hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {ctaLabel}
          <TablerIcon name="arrow-right" class="text-base leading-none" />
        </a>
      </div>

      <!-- Right: image -->
      <div class="overflow-hidden rounded-2xl border border-border shadow-lg aspect-[4/3]" data-reveal style="transition-delay:120ms">
        <img
          src={imageSrc}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
          class="size-full object-cover"
        />
      </div>
    </div>

  </div>
</section>
