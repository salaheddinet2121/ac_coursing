---
import TablerIcon from './TablerIcon.astro';
import { client } from '../data/client';
import type { ReviewExcerpt } from '../data/reviews';

interface Props {
  reviews: ReviewExcerpt[];
  heading?: string;
}

const { reviews, heading = 'Ce que disent nos clients' } = Astro.props;
---

<section class="bg-panel py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h2 class="font-heading text-h2 text-foreground" data-reveal>{heading}</h2>

    <ul class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
      {reviews.map(({ quote, author, meta }) => (
        <li class="flex flex-col rounded-xl border border-border bg-background p-6" data-reveal>
          <div class="mb-3 flex gap-1" aria-label="Noté 5 sur 5">
            {Array.from({ length: 5 }).map(() => (
              <TablerIcon name="star-filled" class="text-lg leading-none text-primary" />
            ))}
          </div>
          <blockquote class="flex-1 leading-relaxed text-muted-foreground">&ldquo;{quote}&rdquo;</blockquote>
          <p class="mt-4 border-t border-border pt-3 text-sm">
            <span class="font-semibold text-primary">{author}</span>
            <span class="text-muted-foreground"> · {meta ? `${meta} · ` : ''}Avis Google</span>
          </p>
        </li>
      ))}
    </ul>

    <div class="mt-8">
      <a
        href={client.socials.google}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border bg-card px-5 py-3 text-sm font-semibold text-muted-foreground transition-all hover:border-primary/40 hover:text-primary"
      >
        <TablerIcon name="brand-google" class="text-xl leading-none" />
        Voir tous les avis Google
      </a>
    </div>
  </div>
</section>
