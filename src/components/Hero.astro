---
import TablerIcon from './TablerIcon.astro';

interface Props {
  topper?: string;
  heading?: string;
  description?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  imageSrc?: string;
  imageAlt?: string;
  formTitle?: string;
  formAction?: string;
  submitLabel?: string;
  ratingValue?: string;
  points?: { icon: 'shield-check' | 'truck-delivery' | 'check'; label: string }[];
  floors?: { value: string; label: string }[];
}

const {
  topper         = 'Déménagement à Montpellier',
  heading        = 'Déménageur à Montpellier : votre déménagement, géré avec soin.',
  description    = "AC Coursing est votre déménageur à Montpellier, avec un devis gratuit sous 24h et un prix fixe garanti du premier jour au dernier carton.",
  secondaryLabel = 'Voir les services',
  secondaryHref  = '/#services',
  imageSrc       = '/hero_image.webp',
  imageAlt       = 'Camion de déménagement AC Coursing dans les rues de Montpellier',
  formTitle      = 'Obtenez votre devis gratuit',
  formAction     = '/devis',
  submitLabel    = 'Obtenir mon devis gratuit',
  ratingValue    = '5,0/5',
  points = [
    { icon: 'shield-check',   label: "11 ans d'expérience" },
    { icon: 'truck-delivery', label: '1 500+ déménagements' },
    { icon: 'check',          label: '194 avis vérifiés' },
  ],
  floors = [
    { value: '0', label: 'Rez-de-chaussée' },
    { value: '1', label: '1er étage' },
    { value: '2', label: '2e étage' },
    { value: '3', label: '3e étage' },
    { value: '4', label: '4e étage' },
    { value: '5', label: '5e étage et plus' },
  ],
} = Astro.props;

---

<section id="accueil" class="relative isolate overflow-hidden bg-dark">

  <!-- Background photo -->
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src={imageSrc}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="size-full object-cover"
    />
    <div class="absolute inset-0 bg-dark/72"></div>
  </div>

  <div class="relative mx-auto grid max-w-site grid-cols-1 gap-10 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16 lg:py-32">

    <!-- Content -->
    <div class="order-1">

      <!-- Topper -->
      <div class="inline-flex items-center gap-2.5">
        <span class="h-px w-8 bg-primary-soft" aria-hidden="true"></span>
        <span class="text-topper font-bold uppercase tracking-widest text-primary-fg">{topper}</span>
      </div>

      <!-- Heading -->
      <h1 class="mt-5 font-heading text-h1 leading-tight text-primary-fg" transition:name="hero-heading">
        {heading}
      </h1>

      <!-- Description -->
      <p class="mt-5 max-w-xl text-lead leading-relaxed text-primary-fg/70">
        {description}
      </p>

      <!-- Trust points -->
      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm font-semibold text-primary-fg/80">
        {points.map(({ icon, label }) => (
          <span class="inline-flex items-center gap-1.5">
            <TablerIcon name={icon} class="text-base leading-none text-primary-soft" />
            {label}
          </span>
        ))}
      </div>

      <!-- Rating -->
      <div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-primary-fg/70">
        <span class="inline-flex items-center gap-0.5" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => (
            <TablerIcon name="star-filled" class="text-base leading-none text-primary-soft" />
          ))}
        </span>
        <span class="font-semibold text-primary-fg">{ratingValue}</span>
        <span>sur Google</span>
      </div>

      <!-- Secondary CTA -->
      <div class="mt-7">
        <a
          href={secondaryHref}
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border-2 border-primary-fg/30 px-7 py-3 text-base font-bold text-primary-fg transition-colors hover:bg-primary-fg/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-fg"
        >
          {secondaryLabel}
          <TablerIcon name="arrow-right" class="text-base leading-none" />
        </a>
      </div>
    </div>

    <!-- Estimate form card -->
    <div class="order-2 w-full rounded-2xl bg-card p-7 shadow-lg sm:p-9" transition:name="hero-image">
      <h2 class="font-heading text-h2 leading-snug text-foreground">{formTitle}</h2>

      <form method="get" action={formAction} class="mt-6 space-y-4">
        <label class="block">
          <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Adresse de départ</span>
          <div class="relative flex items-center">
            <span class="pointer-events-none absolute left-3 flex size-4 items-center justify-center overflow-hidden text-muted-foreground [&_svg]:size-4">
              <TablerIcon name="map-pin" />
            </span>
            <input
              type="text"
              name="address"
              placeholder="Ex : 12 rue de la Loge, Montpellier"
              class="w-full rounded-lg border border-border bg-background py-3 pr-3 pl-9 text-sm font-medium text-foreground placeholder:text-muted-foreground/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            />
          </div>
        </label>

        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Étage</span>
            <div class="relative flex items-center">
              <span class="pointer-events-none absolute left-3 flex size-4 items-center justify-center overflow-hidden text-muted-foreground [&_svg]:size-4">
                <TablerIcon name="stairs" />
              </span>
              <select
                name="floor"
                class="w-full appearance-none rounded-lg border border-border bg-background py-3 pr-8 pl-9 text-sm font-medium text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              >
                {floors.map((f) => <option value={f.value}>{f.label}</option>)}
              </select>
              <span class="pointer-events-none absolute right-3 flex size-3.5 rotate-90 items-center justify-center overflow-hidden text-muted-foreground [&_svg]:size-3.5">
                <TablerIcon name="chevron-right" />
              </span>
            </div>
          </label>

          <label class="block">
            <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Date</span>
            <div class="relative flex items-center">
              <span class="pointer-events-none absolute left-3 flex size-4 items-center justify-center overflow-hidden text-muted-foreground [&_svg]:size-4">
                <TablerIcon name="calendar" />
              </span>
              <input
                type="date"
                name="date"
                class="w-full appearance-none rounded-lg border border-border bg-background py-3 pr-3 pl-9 text-sm font-medium text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              />
            </div>
          </label>
        </div>

        <button
          type="submit"
          class="inline-flex min-h-13 w-full items-center justify-center rounded-full bg-primary px-6 py-3 text-base font-bold text-primary-foreground shadow-md transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {submitLabel}
        </button>
      </form>
    </div>

  </div>
</section>
