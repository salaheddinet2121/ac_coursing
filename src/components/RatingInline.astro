---
import TablerIcon from './TablerIcon.astro';
import { getPlacesData, formatRating } from '../lib/google-places';

const places = await getPlacesData();
---

<p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-primary-fg/80">
  <span class="inline-flex gap-0.5" aria-hidden="true">
    {Array.from({ length: 5 }).map(() => (
      <TablerIcon name="star-filled" class="text-base leading-none text-primary-soft" />
    ))}
  </span>
  <span class="font-semibold text-primary-fg">{formatRating(places.rating)}</span>
  <span>·</span>
  <span>{places.reviewCount} avis Google</span>
</p>
