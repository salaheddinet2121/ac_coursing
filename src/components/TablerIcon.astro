---
import TablerIconReact from './TablerIcon.tsx';

interface Props {
  name: string;
  filled?: boolean;
  class?: string;
  id?: string;
  stroke?: number;
}

const { name, filled, class: className, id, stroke } = Astro.props;
---

<TablerIconReact name={name} filled={filled} class={className} id={id} stroke={stroke} />
